# Copiez ce fichier en `.env.local` et remplissez les valeurs.
# Les vraies valeurs ne doivent JAMAIS être committées.

# Token d'accès "Preview" (Storyblok > Settings > Access Tokens) — lit brouillons + publiés.
# Utilisé uniquement côté serveur, quand le Draft Mode est actif (éditeur visuel).
STORYBLOK_PREVIEW_TOKEN=

# Token d'accès "Public" — ne peut lire QUE le contenu publié. Utilisé pour le site public.
STORYBLOK_PUBLIC_TOKEN=

# Secret partagé pour le webhook de revalidation (optionnel — voir STORYBLOK_SETUP.md).
STORYBLOK_WEBHOOK_SECRET=

# Mode développement sans API : rend le site depuis scripts/storyblok/content/*.json.
# Ne jamais activer sur Vercel.
# STORYBLOK_LOCAL_CONTENT=1

# --- Essai Plasmic (éditeur visuel libre, pages sous /essai-plasmic) ---
# Token de projet Plasmic : lecture seule du contenu publié, public par conception.
# Studio → Code (barre d'outils) → project ID + public API token.
NEXT_PUBLIC_PLASMIC_PROJECT_ID=
NEXT_PUBLIC_PLASMIC_PROJECT_TOKEN=
